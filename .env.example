# Copy this file to .env and fill in your local values
# .env is gitignored and never committed

DATABASE_URL=postgresql://postgres:yourpassword@localhost/trees_db
SECRET_KEY=change-me-to-a-long-random-string

# Password reset via Gmail SMTP
# SMTP_PASSWORD must be a Gmail App Password (not your regular Gmail password)
# To create one: Google Account > Security > 2-Step Verification > App passwords
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
APP_BASE_URL=https://your-app.railway.app
